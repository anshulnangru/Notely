%%{init: {'flowchart': {'curve': 'basis', 'nodeSpacing': 75, 'rankSpacing': 100, 'padding': 28}, 'themeVariables': {'fontSize': '18px', 'fontFamily': 'Georgia'}} }%%
flowchart LR
    START([Start])
    AUTH[Login / Register]
    VERIFY[Verify Email]
    WORKSPACE[Open Workspace]
    NAVIGATE[Browse Sidebar / Page Tree]
    PAGE[Create or Open Page]
    EDIT[Edit Blocks and Content]
    TASKS[Create and Manage Tasks]
    COMMENTS[Add Comments]
    FILES[Upload Attachments]
    SHARE[Share Page / Invite Members]
    COLLAB[Live Collaboration]
    TRACK[Inbox / Dashboard / Calendar]
    END([Continue Working])

    START --> AUTH
    AUTH --> VERIFY
    VERIFY --> WORKSPACE
    WORKSPACE --> NAVIGATE
    NAVIGATE --> PAGE
    PAGE --> EDIT
    EDIT --> TASKS
    EDIT --> COMMENTS
    EDIT --> FILES
    TASKS --> SHARE
    COMMENTS --> SHARE
    FILES --> SHARE
    SHARE --> TRACK
    SHARE --> COLLAB
    COLLAB --> TRACK
    TRACK --> END

    classDef step fill:#dbe9ff,stroke:#7aa1e6,color:#1f355e,stroke-width:1.8px;
    classDef edge fill:#dff0d8,stroke:#7cb36e,color:#1f2d1f,stroke-width:1.5px;

    class AUTH,VERIFY,WORKSPACE,NAVIGATE,PAGE,EDIT,TASKS,COMMENTS,FILES,SHARE,COLLAB,TRACK step;
    class START,END edge;
