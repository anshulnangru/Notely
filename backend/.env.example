# Copy to .env for local development. NEVER commit the real .env.

# Leave unset locally to use the SQLite file (notion.db).
# On Render, paste the Postgres connection string (Neon/Supabase/etc).
DATABASE_URL=

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Your Vercel URL, used in email links (verification, reset, invites)
APP_BASE_URL=http://localhost:5173

# Extra allowed browser origins, comma-separated (no trailing slash)
CORS_ORIGINS=

# Leave SMTP_* UNSET on Render free: outbound SMTP is blocked, and with SMTP
# unset, new accounts are activated immediately (no email verification).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
